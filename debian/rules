#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export QT_SELECT := qt5
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --sourcedirectory=src --buildsystem=qmake

override_dh_auto_configure:
	dh_auto_configure -- VERSION_STRING=$(DEB_VERSION_UPSTREAM)

# yappari-wa is written in Go and cross-built on a PC beforehand, because
# Debian 12's Go is too old for whatsmeow (see README.md, "Building").
override_dh_auto_install:
	dh_auto_install
	@test -x backend/yappari-wa || { echo "backend/yappari-wa is missing: build it first (README.md)"; exit 1; }
	@readelf -h backend/yappari-wa | grep -q AArch64 || { echo "backend/yappari-wa is not an arm64 binary"; exit 1; }
	install -D -m 0755 backend/yappari-wa debian/yappari-leste/usr/libexec/yappari/yappari-wa

# The Go binary is stripped already and has no DWARF for dwz
override_dh_strip:
	dh_strip --exclude=yappari-wa

override_dh_dwz:
